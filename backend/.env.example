# Copy this file to backend/.env and fill in your own values. NEVER commit .env.
# Leave LLM_API_KEY empty to run in demo mode (rule-based reports, no AI model).
LLM_API_KEY=
# OpenAI-compatible chat completions endpoint. These defaults are for ASI:One and are
# assumptions: confirm the base URL and model name in your provider's dashboard.
LLM_BASE_URL=https://api.asi1.ai/v1
LLM_MODEL=asi1-mini
LLM_TIMEOUT=40
# Max tokens the model may write. Reasoning models need room to think; raise this if replies get cut off.
LLM_MAX_TOKENS=4000
PORT=8000
# Comma-separated browser origins allowed to call the API (VS Code Live Server uses 5500)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MIN=10
CHAT_RATE_LIMIT_PER_MIN=20
# Needed only to let Ask AI Agent read images (JPG/PNG). Must be a vision-capable model on your provider.
# Leave empty to disable image reading. Check your provider's model list for a current vision model name.
LLM_VISION_MODEL=

# ---- Accounts, saved chats, reviews (added in the web-app upgrade) ----
# SQLite file for users, sessions, chats, quiz history, reviews and contact messages. Default: <project>/instance/studygap.db
# DATABASE_PATH=
# Comma-separated emails of accounts allowed to approve reviews and read contact messages (the Admin page). They must also sign up.
ADMIN_EMAILS=
# Set to 1 when the site is served over HTTPS so the login cookie is marked Secure. Leave 0 for http://localhost.
COOKIE_SECURE=0
# How long a login lasts, in days.
SESSION_DAYS=7
# Set to 1 ONLY when a reverse proxy on the same machine sits in front of the app and sets the X-Real-IP header (see DEPLOYMENT.md).
# Without it, behind a proxy every visitor shares one rate limit. Leave 0 for local use.
TRUST_PROXY=0
